{
  "name": "Fedora KDE Desktop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // GitHub Codespaces are devcontainers, and the spec supports giving the
  // container a real Linux boot:
  //   privileged: true      -> the runtime starts the container with the
  //                            capabilities systemd needs (--privileged);
  //   overrideCommand:false -> the container's own command (the image CMD,
  //                            container-init.sh) runs as PID 1 instead of
  //                            a forced "sleep infinity" loop, so systemd
  //                            can be the true init, exactly like a
  //                            normal Fedora machine booting up.
  // container-init.sh keeps every path safe: real user sessions boot
  // systemd; prebuild containers (no CODESPACE_NAME yet) stay a plain
  // keep-alive shim so the prebuild snapshot stays clean and the shutdown
  // job never hangs on a systemd that ignores SIGTERM.
  "privileged": true,
  "overrideCommand": false,
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode",
  "postStartCommand": "/usr/local/bin/start-desktop.sh",
  "postAttachCommand": "/usr/local/bin/start-desktop.sh"
}
